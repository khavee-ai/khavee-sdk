{
  "name": "@khaveeai/sdk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @khaveeai/playground build",
    "build:packages": "pnpm --filter './packages/**' build",
    "clean": "pnpm --filter './packages/**' clean",
    "dev": "pnpm --filter @khaveeai/playground dev",
    "dev:packages": "pnpm --filter './packages/**' dev",
    "lint": "pnpm --filter @khaveeai/playground lint",
    "prepublishOnly": "pnpm run clean && pnpm run build:packages",
    "publish:all": "pnpm run prepublishOnly && pnpm --filter './packages/**' publish --access public",
    "version:major": "pnpm --filter './packages/**' exec npm version major",
    "version:minor": "pnpm --filter './packages/**' exec npm version minor",
    "version:patch": "pnpm --filter './packages/**' exec npm version patch"
  },
  "devDependencies": {
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.12.1"
}
