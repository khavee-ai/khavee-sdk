{
  "name": "@khaveeai/core",
  "version": "0.6.1",
  "description": "Core VRM AI avatar functionality",
  "keywords": [
    "vrm",
    "avatar",
    "ai",
    "3d",
    "animation"
  ],
  "homepage": "https://github.com/khavee-ai/khavee-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khavee-ai/khavee-sdk.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/khavee-ai/khavee-sdk/issues"
  },
  "author": "KhaveeAI <support@khaveeai.com>",
